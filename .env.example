# ── Docker Compose quick start (docker compose up) ───────────────────────────
# Your first login, created on the first `docker compose up`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# This machine's IP address as other clusters see it (e.g. `hostname -I`).
# Clusters you add to Daalu dial the WireGuard hub here (UDP 51820) and call
# back to the API on :8000. Leave empty to run Daalu without managed clusters.
DAALU_HOST_IP=

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Shared secret webhooks send in X-Daalu-Key to POST /api/v1/events.
# Leave blank in dev (gate is open); in prod set to a random 32-byte hex.
INGEST_API_KEY=
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://daalu:daalu_password@localhost:5432/daalu_automation
DATABASE_SYNC_URL=postgresql://daalu:daalu_password@localhost:5432/daalu_automation

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Object Storage (S3 / MinIO / Rook-Ceph RGW) ──────────────────────────────
# In prod, point at any S3-compatible endpoint (e.g. a Rook-Ceph RGW), so
# only one Ceph cluster has to be operated.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=daalu_access_key
S3_SECRET_KEY=daalu_secret_key
S3_BUCKET_REPORTS=daalu-reports
S3_BUCKET_EVENTS=daalu-events
S3_BUCKET_ATTACHMENTS=daalu-attachments

# ── LLM — Anthropic (primary) ─────────────────────────────────────────────────
# Anthropic is optional; any OpenAI-compatible endpoint works via LLM_*
# platforms. ANTHROPIC_MODEL is the default; modules can override per-call.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MODEL_FAST=claude-haiku-4-5
ANTHROPIC_CACHE_ENABLED=true

# ── LLM — OpenAI-compatible fallback (optional) ──────────────────────────────
# When set, modules can opt into the cheaper classifier tier (DeepSeek,
# Together, DeepInfra, Fireworks, OpenAI). 
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_MODEL_CLASSIFIER=deepseek-chat

# ── LLM — your own model (optional, preferred when set) ─────────────────────
# Any OpenAI-compatible server you run (vLLM, llama.cpp server, Ollama's /v1).
# When set, the router tries it first and falls back to the hosted tiers above.
LLM_LOCAL_BASE_URL=
LLM_LOCAL_API_KEY=
# The model name your server reports (GET /v1/models).
LLM_LOCAL_MODEL_CLASSIFIER=meta/llama-3.1-8b-instruct

# ── GPU inference (RunPod / Replicate) ────────────────────────────────────────
# Optional — only needed for modules that call a hosted model directly
# (e.g. on-cluster embedding service, custom forecasting model).
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
REPLICATE_API_TOKEN=

# ── Briefing scheduler ────────────────────────────────────────────────────────
# Cron expressions used by `daalu-automation/src/daalu_automation/workers/celery_app.py`.
# Default: every weekday at 07:00 in the tenant's timezone.
DAILY_BRIEFING_CRON=0 7 * * 1-5
BRIEFING_LOOKBACK_HOURS=24

# ── Notifications ─────────────────────────────────────────────────────────────
# Slack incoming webhook for AI briefings + critical alerts. Leave blank
# to disable Slack delivery (briefings still render in the UI + email).
SLACK_WEBHOOK_URL=
SLACK_BRIEFING_CHANNEL=#operations
# SMTP for email briefings — same envelope as a transactional service.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# ── Integration: Salesforce / HubSpot (Sales / RevOps) ───────────────────────
# Used by the sales module's CRM connector. Leave blank to use the
# in-process mock CRM (seed data only — handy for local demos).
SALESFORCE_INSTANCE_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REFRESH_TOKEN=
HUBSPOT_API_KEY=

# ── Integration: Prometheus / PagerDuty / Datadog (IT / SRE) ─────────────────
PROMETHEUS_URL=
PAGERDUTY_API_TOKEN=
PAGERDUTY_ROUTING_KEY=
DATADOG_API_KEY=
DATADOG_APP_KEY=

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=daalu-automation-api
