{% extends "base.html.j2" %}
{% block title %}Dashboard{% endblock %}

{% block content %}
<div class="flex items-end justify-between mb-8">
  <div>
    <div class="eyebrow mb-2">Overview</div>
    <h1 class="h-display">Operations</h1>
    <p class="muted text-sm mt-2">
      Live across <span class="accent-fg font-medium">{{ namespaces | length }}</span> namespace{% if namespaces|length != 1 %}s{% endif %}
      · refreshing every 10s
    </p>
  </div>
  <div class="flex items-center gap-2">
    <a href="/workflows/new" class="btn btn-primary">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
      Start workflow
    </a>
    <a href="/workflows" class="btn btn-ghost">Browse all</a>
  </div>
</div>

<div hx-get="/partials/dashboard-stats"
     hx-trigger="load, every 10s"
     hx-swap="innerHTML transition:true">
  <div class="card p-12 text-center muted">
    <div class="inline-block">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
           class="animate-spin">
        <circle cx="12" cy="12" r="10" stroke-dasharray="50 30" stroke-linecap="round"/>
      </svg>
    </div>
    <div class="mt-3 text-sm">Loading namespaces…</div>
  </div>
</div>
{% endblock %}
