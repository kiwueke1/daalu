{% extends "base.html.j2" %}
{% block title %}{{ workflow_id[:18] }}…{% endblock %}

{% block content %}
<div class="mb-6">
  <a href="/workflows?namespace={{ namespace }}" class="muted hover:accent-fg text-sm inline-flex items-center gap-1.5 transition">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
    All workflows
  </a>
</div>

<div class="flex items-start justify-between mb-8 gap-6">
  <div class="min-w-0 flex-1">
    <div class="flex items-center gap-3 mb-3">
      <span class="badge badge-{{ status_class }}">{{ status_label }}</span>
      <span class="mono subtle text-xs">{{ type }}</span>
    </div>
    <h1 class="h-display mono break-all leading-tight">{{ workflow_id }}</h1>
    <div class="muted text-sm mt-3 flex flex-wrap gap-4">
      <span>
        <span class="subtle">Namespace:</span>
        <span class="font-medium">{{ namespace_display(namespace) }}</span>
      </span>
      <span>
        <span class="subtle">Queue:</span>
        <span class="mono">{{ task_queue }}</span>
      </span>
      {% if start %}
      <span>
        <span class="subtle">Started:</span>
        {{ start.strftime('%b %d, %Y · %H:%M:%S UTC') }}
      </span>
      {% endif %}
    </div>
  </div>
  {% if deep_link %}
    <a href="{{ deep_link }}" target="_blank" rel="noopener" class="btn btn-primary shrink-0">
      Open in app
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M7 7h10v10"/></svg>
    </a>
  {% endif %}
</div>

<!-- Pipeline progress (HTMX-polled, collapsible per-stage cards) -->
<div class="mb-6"
     hx-get="/workflows/{{ workflow_id }}/progress.html?namespace={{ namespace }}"
     hx-trigger="load"
     hx-swap="innerHTML">
  <div class="card p-6 text-sm muted">Loading pipeline progress…</div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <!-- Timeline -->
  <div class="lg:col-span-2">
    <div class="card p-6">
      <div class="flex items-center justify-between mb-5">
        <div>
          <div class="eyebrow mb-0.5">Activity</div>
          <h2 class="h-section">History timeline</h2>
        </div>
        <div class="badge badge-neutral">{{ events|length }} events</div>
      </div>
      {% if events %}
        <div class="timeline scroll-area pr-2" style="max-height: 580px">
          {% for ev in events %}
            {% set evt_class = '' %}
            {% if 'Started' in ev.type or 'Scheduled' in ev.type %}{% set evt_class = 'accent' %}
            {% elif 'Completed' in ev.type %}{% set evt_class = 'success' %}
            {% elif 'Failed' in ev.type or 'Terminated' in ev.type %}{% set evt_class = 'danger' %}
            {% endif %}
            <div class="timeline-event {{ evt_class }}">
              <div class="flex items-baseline justify-between gap-3">
                <div class="text-sm font-medium">{{ ev.type }}</div>
                <div class="text-xs subtle mono shrink-0">{% if ev.time %}{{ ev.time.strftime('%H:%M:%S') }}{% endif %}</div>
              </div>
              <div class="text-xs subtle mono mt-0.5">event #{{ ev.id }}</div>
            </div>
          {% endfor %}
        </div>
      {% else %}
        <div class="text-sm muted py-4">No events recorded.</div>
      {% endif %}
    </div>
  </div>

  <!-- Side panel -->
  <div class="space-y-4">
    <div class="card p-6">
      <div class="eyebrow mb-4">Metadata</div>
      <dl class="space-y-4 text-sm">
        <div>
          <dt class="subtle text-xs mb-1">Run ID</dt>
          <dd class="mono text-xs break-all">{{ run_id }}</dd>
        </div>
        <div>
          <dt class="subtle text-xs mb-1">Started at</dt>
          <dd>{{ start.strftime("%b %d, %Y · %H:%M:%S UTC") if start else "—" }}</dd>
        </div>
        {% if end %}
        <div>
          <dt class="subtle text-xs mb-1">Ended at</dt>
          <dd>{{ end.strftime("%b %d, %Y · %H:%M:%S UTC") }}</dd>
        </div>
        {% endif %}
      </dl>
    </div>

    {% if status_name == "Running" %}
    <div class="card card-accent p-6">
      <div class="eyebrow mb-4">Send signal</div>
      <form method="post" action="/workflows/{{ workflow_id }}/signal" class="space-y-3 text-sm">
        <input type="hidden" name="namespace" value="{{ namespace }}">
        <input type="text" name="signal_name" placeholder="e.g. approve_script" required class="w-full">
        <textarea name="payload_json" rows="3" placeholder='optional JSON, e.g. "rejected"' class="w-full"></textarea>
        <button type="submit" class="btn btn-primary w-full">Send signal</button>
      </form>
    </div>

    <div class="card p-6">
      <div class="eyebrow mb-4" style="color: var(--danger)">Danger zone</div>
      <form method="post" action="/workflows/{{ workflow_id }}/cancel" class="mb-3">
        <input type="hidden" name="namespace" value="{{ namespace }}">
        <button type="submit" class="btn btn-ghost w-full">Cancel gracefully</button>
      </form>
      <form method="post" action="/workflows/{{ workflow_id }}/terminate" class="space-y-3"
            onsubmit="return confirm('Terminate immediately? In-flight activities will be killed.')">
        <input type="hidden" name="namespace" value="{{ namespace }}">
        <input type="text" name="reason" placeholder="reason (optional)" class="w-full">
        <button type="submit" class="btn btn-danger w-full">Terminate</button>
      </form>
    </div>
    {% endif %}
  </div>
</div>
{% endblock %}
