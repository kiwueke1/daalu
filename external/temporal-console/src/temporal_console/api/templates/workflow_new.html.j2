{% extends "base.html.j2" %}
{% block title %}Start workflow{% endblock %}

{% block content %}
<div class="max-w-2xl">
  <div class="mb-8">
    <div class="eyebrow mb-2">New</div>
    <h1 class="h-display">Start a workflow</h1>
    <p class="muted text-sm mt-3">
      Schedules a new workflow execution on the selected namespace. The payload is passed as the single argument to the workflow's <span class="mono accent-fg">run</span> method.
    </p>
  </div>

  {% if error %}
    <div class="card p-4 mb-6 text-sm flex gap-3 items-start"
         style="background: color-mix(in srgb, var(--danger) 8%, var(--bg-card)); border-color: color-mix(in srgb, var(--danger) 30%, var(--border));">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--danger); margin-top: 1px;">
        <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
      </svg>
      <div style="color: var(--danger)">{{ error }}</div>
    </div>
  {% endif %}

  <form method="post" action="/workflows/new" class="card p-8 space-y-5">
    <label class="block text-sm">
      <div class="eyebrow mb-1.5">Namespace</div>
      <select name="namespace" required class="w-full">
        {% for ns in namespaces %}
          <option value="{{ ns }}" {% if ns == namespace %}selected{% endif %}>{{ namespace_display(ns) }}</option>
        {% endfor %}
      </select>
    </label>

    <label class="block text-sm">
      <div class="eyebrow mb-1.5">Workflow type</div>
      <input type="text" name="workflow_type" value="{{ workflow_type or '' }}"
             required placeholder="PipelineWorkflow" class="w-full font-mono">
      <div class="text-xs subtle mt-1.5">The registered workflow class name.</div>
    </label>

    <label class="block text-sm">
      <div class="eyebrow mb-1.5">Task queue</div>
      <input type="text" name="task_queue" value="{{ task_queue or 'ajani-pipeline-production' }}"
             required placeholder="ajani-pipeline-production" class="w-full font-mono">
    </label>

    <label class="block text-sm">
      <div class="eyebrow mb-1.5">Workflow ID <span class="subtle">(optional)</span></div>
      <input type="text" name="workflow_id" value="{{ workflow_id_in or '' }}"
             placeholder="auto-generated if blank" class="w-full font-mono">
    </label>

    <label class="block text-sm">
      <div class="eyebrow mb-1.5">Payload (JSON)</div>
      <textarea name="payload_json" rows="8" class="w-full"
                placeholder='{"tenant_id": "...", "topic_id": "...", "format": "short_60"}'>{{ payload_json or '' }}</textarea>
      <div class="text-xs subtle mt-1.5">
        The top-level value is passed as the single positional arg. Use <span class="mono accent-fg">null</span> to pass no args.
      </div>
    </label>

    <div class="flex justify-end gap-2 pt-3">
      <a href="/workflows" class="btn btn-ghost">Cancel</a>
      <button type="submit" class="btn btn-primary">
        Start workflow
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </button>
    </div>
  </form>
</div>
{% endblock %}
