        {
          "name": "no_wait",
          "label": "Don't wait for deprovisioning",
          "type": "bool",
          "required": false,
          "default": false,
          "placeholder": "",
          "help": "",
          "choices": null,
          "advanced": false
        },
        {
          "name": "wipe_mgmt",
          "label": "Wipe management cluster",
          "type": "bool",
          "required": false,
          "default": false,
          "placeholder": "",
          "help": "Also kubeadm-reset the management node.",
          "choices": null,
          "advanced": false
        },
        {
          "name": "install",
          "label": "Install plan filter",
          "type": "string",
          "required": false,
          "default": null,
          "placeholder": "",
          "help": "",
          "choices": null,
          "advanced": true
        },
        {
          "name": "infra",
          "label": "Infra filter",
          "type": "string",
          "required": false,
          "default": null,
          "placeholder": "",
          "help": "",
          "choices": null,
          "advanced": true
        },
        {
          "name": "kubeconfig",
          "label": "Workload kubeconfig",
          "type": "string",
          "required": false,
          "default": null,
          "placeholder": "",
          "help": "",
          "choices": null,
          "advanced": true
        },
        {
          "name": "ssh_password",
          "label": "SSH password",
          "type": "secret",
          "required": false,
          "default": null,
          "placeholder": "",
          "help": "",
          "choices": null,
          "advanced": true
        },
        {
          "name": "debug",
          "label": "Verbose logging",
          "type": "bool",
          "required": false,
          "default": false,
          "placeholder": "",
          "help": "",
          "choices": null,
          "advanced": true
        }
      ],
      "workflow_id_template": "{workflow_type}-{timestamp}"
    },
    {
      "workflow_type": "MirrorImages",
      "task_queue": "daalu.deployments",
      "title": "Mirror images to Harbor",
      "description": "Pull all required images from public registries and push to local Harbor.",
      "fields": [
        {
          "name": "harbor_url",
          "label": "Harbor URL",
          "type": "string",
          "required": true,
          "default": "10.10.0.9:30003",
          "placeholder": "",
          "help": "",
          "choices": null,
          "advanced": false
        },
        {
          "name": "config_path",
          "label": "Cluster config",
          "type": "string",
          "required": false,
          "default": "cluster-defs/cluster.yaml",
          "placeholder": "",
          "help": "",
          "choices": null,
          "advanced": false
        }
      ],
      "workflow_id_template": "{workflow_type}-{timestamp}"
    }
  ]
}
