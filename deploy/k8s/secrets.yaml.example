# Stamp out a real Secret from this template using `sops` (production) or
# `kubectl create secret generic --from-env-file=.env`.
# Fill in your LLM key and S3-compatible endpoint.
apiVersion: v1
kind: Secret
metadata:
  name: daalu-automation-secrets
  namespace: daalu-automation
type: Opaque
stringData:
  # ── Database ──────────────────────────────────────────────────────────────
  DATABASE_URL: postgresql+asyncpg://daalu:daalu_password@daalu-postgres.daalu-automation.svc.cluster.local:5432/daalu_automation
  DATABASE_SYNC_URL: postgresql://daalu:daalu_password@daalu-postgres.daalu-automation.svc.cluster.local:5432/daalu_automation
  # ── Redis ─────────────────────────────────────────────────────────────────
  REDIS_URL: redis://daalu-redis.daalu-automation.svc.cluster.local:6379/0
  CELERY_BROKER_URL: redis://daalu-redis.daalu-automation.svc.cluster.local:6379/0
  CELERY_RESULT_BACKEND: redis://daalu-redis.daalu-automation.svc.cluster.local:6379/1
  # ── Object storage — any S3-compatible endpoint (e.g. Rook-Ceph RGW) ──────────────
  S3_ENDPOINT_URL: http://rook-ceph-rgw-ceph.openstack.svc.cluster.local
  S3_ACCESS_KEY: REPLACE_WITH_ROOK_RGW_ACCESS_KEY
  S3_SECRET_KEY: REPLACE_WITH_ROOK_RGW_SECRET_KEY
  S3_BUCKET_REPORTS: daalu-reports
  S3_BUCKET_EVENTS: daalu-events
  S3_BUCKET_ATTACHMENTS: daalu-attachments
  # ── LLM (Anthropic or any OpenAI-compatible provider) ───────────────────────────────────
  ANTHROPIC_API_KEY: REPLACE_WITH_ANTHROPIC_KEY
  ANTHROPIC_MODEL: claude-sonnet-4-6
  ANTHROPIC_MODEL_FAST: claude-haiku-4-5
  ANTHROPIC_CACHE_ENABLED: "true"
  # ── Optional OpenAI-compatible classifier tier ───────────────────────────
  LLM_API_KEY: ""
  LLM_BASE_URL: https://api.deepseek.com
  LLM_MODEL: deepseek-chat
  LLM_MODEL_CLASSIFIER: deepseek-chat
  # ── Notifications ────────────────────────────────────────────────────────
  SLACK_WEBHOOK_URL: ""
  SLACK_BRIEFING_CHANNEL: "#operations"
  # ── App ──────────────────────────────────────────────────────────────────
  SECRET_KEY: REPLACE_WITH_OPENSSL_RAND_HEX_32
  ENVIRONMENT: production
  LOG_LEVEL: INFO
  CORS_ORIGINS: '["https://daalu.example.com"]'
